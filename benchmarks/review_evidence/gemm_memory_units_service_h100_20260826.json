    "reference_code": "\nimport torch\n\nclass Model(torch.nn.Module):\n    def forward(self, lhs, rhs):\n        return torch.matmul(lhs, rhs)\n\ndef get_init_inputs():\n    return []\n\ndef get_inputs():\n    return [torch.randn(512, 512), torch.randn(512, 512)]\n",
    "kernel_code": "\n### CUDA_KERNELS\n```cpp\n#include <cuda_runtime.h>\n\n__global__ void gemm_kernel(const float* lhs, const float* rhs, float* output, int m, int n, int k) {\n    int col = blockIdx.x * blockDim.x + threadIdx.x;\n    int row = blockIdx.y * blockDim.y + threadIdx.y;\n    if (row >= m || col >= n) return;\n    float sum = 0.0f;\n    for (int inner = 0; inner < k; ++inner) {\n        sum += lhs[row * k + inner] * rhs[inner * n + col];\n    }\n    output[row * n + col] = sum;\n}\n\nextern \"C\" void gemm_launcher(\n    const float* lhs, const float* rhs, float* output, int m, int n, int k, void* stream_handle) {\n    auto stream = static_cast<cudaStream_t>(stream_handle);\n    dim3 block(16, 16);\n    dim3 grid((n + block.x - 1) / block.x, (m + block.y - 1) / block.y);\n    gemm_kernel<<<grid, block, 0, stream>>>(lhs, rhs, output, m, n, k);\n}\n```\n\n### APPLY_BINDINGS\n```cpp\n#include <tvm/ffi/tvm_ffi.h>\n#include <tvm/ffi/extra/c_env_api.h>\n\nextern \"C\" void gemm_launcher(\n    const float* lhs, const float* rhs, float* output, int m, int n, int k, void* stream_handle);\n\nvoid gemm_forward(tvm::ffi::Tensor lhs, tvm::ffi::Tensor rhs, tvm::ffi::Tensor output) {\n    auto lhs_shape = lhs.shape();\n    auto rhs_shape = rhs.shape();\n    void* stream = TVMFFIEnvGetStream(lhs.device().device_type, lhs.device().device_id);\n    gemm_launcher(\n        static_cast<const float*>(lhs.data_ptr()),\n        static_cast<const float*>(rhs.data_ptr()),\n        static_cast<float*>(output.data_ptr()),\n        static_cast<int>(lhs_shape[0]),\n        static_cast<int>(rhs_shape[1]),\n        static_cast<int>(lhs_shape[1]),\n        stream);\n}\n\nTVM_FFI_DLL_EXPORT_TYPED_FUNC(gemm_forward, gemm_forward);\n```\n\n### MODEL_NEW\n```python\nimport torch\nimport tvm_ffi_extension\n\nclass ModelNew(torch.nn.Module):\n    def forward(self, lhs, rhs):\n        output = torch.empty((lhs.shape[0], rhs.shape[1]), device=lhs.device, dtype=lhs.dtype)\n        tvm_ffi_extension.gemm_forward(lhs, rhs, output)\n        return output\n```\n",
