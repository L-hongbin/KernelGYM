    "reference_code": "\nimport torch\nimport torch.nn as nn\n\n\nclass Model(nn.Module):\n    def forward(self, a, b):\n        return torch.matmul(a, b)\n\n\ndef get_init_inputs():\n    return []\n\n\ndef get_inputs():\n    return [\n        torch.randn(1024, 1024, dtype=torch.float32),\n        torch.randn(1024, 1024, dtype=torch.float32),\n    ]\n",
    "kernel_code": "\n### CUDA_KERNELS\n```cpp\n#include <cuda_runtime.h>\n\n__global__ void gemm_kernel(\n    const float* a,\n    const float* b,\n    float* c,\n    int m,\n    int n,\n    int k) {\n    int row = blockIdx.y * blockDim.y + threadIdx.y;\n    int col = blockIdx.x * blockDim.x + threadIdx.x;\n    if (row < m && col < n) {\n        float sum = 0.0f;\n        for (int inner = 0; inner < k; ++inner) {\n            sum += a[row * k + inner] * b[inner * n + col];\n        }\n        c[row * n + col] = sum;\n    }\n}\n\nextern \"C\" void gemm_launcher(\n    const float* a,\n    const float* b,\n    float* output,\n    int m,\n    int n,\n    int k,\n    void* stream_handle) {\n    cudaStream_t stream = static_cast<cudaStream_t>(stream_handle);\n    dim3 threads(16, 16);\n    dim3 blocks(\n        (static_cast<unsigned int>(n) + threads.x - 1) / threads.x,\n        (static_cast<unsigned int>(m) + threads.y - 1) / threads.y);\n    gemm_kernel<<<blocks, threads, 0, stream>>>(\n        a, b, output, m, n, k);\n}\n```\n\n### APPLY_BINDINGS\n```cpp\n#include <tvm/ffi/tvm_ffi.h>\n#include <tvm/ffi/extra/c_env_api.h>\n\nextern \"C\" void gemm_launcher(\n    const float* a,\n    const float* b,\n    float* output,\n    int m,\n    int n,\n    int k,\n    void* stream_handle);\n\nvoid gemm_forward(\n    tvm::ffi::Tensor a,\n    tvm::ffi::Tensor b,\n    tvm::ffi::Tensor output) {\n    auto a_shape = a.shape();\n    auto b_shape = b.shape();\n    int m = static_cast<int>(a_shape[0]);\n    int k = static_cast<int>(a_shape[1]);\n    int n = static_cast<int>(b_shape[1]);\n    void* stream =\n        TVMFFIEnvGetStream(a.device().device_type, a.device().device_id);\n    gemm_launcher(\n        static_cast<const float*>(a.data_ptr()),\n        static_cast<const float*>(b.data_ptr()),\n        static_cast<float*>(output.data_ptr()),\n        m,\n        n,\n        k,\n        stream);\n}\n\nTVM_FFI_DLL_EXPORT_TYPED_FUNC(gemm_forward, gemm_forward);\n```\n\n### MODEL_NEW\n```python\nimport torch\nimport torch.nn as nn\nimport tvm_ffi_extension\n\n\nclass ModelNew(nn.Module):\n    def forward(self, a, b):\n        output = torch.empty(\n            (a.shape[0], b.shape[1]),\n            device=a.device,\n            dtype=a.dtype,\n        )\n        scratch = torch.empty(\n            (16 * 1024 * 1024,),\n            device=a.device,\n            dtype=a.dtype,\n        )\n        tvm_ffi_extension.gemm_forward(a, b, output)\n        del scratch\n        return output\n```\n",
